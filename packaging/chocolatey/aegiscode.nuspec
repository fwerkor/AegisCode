<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>aegiscode</id>
    <version>0.5.0</version>
    <title>AegisCode</title>
    <authors>Castronaut</authors>
